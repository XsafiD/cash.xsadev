# Salin ke .env lalu isi nilai nyata.
# Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-fallback-JANGAN-dipakai-production

# MySQL dev (docker-compose.yml → host port 3307)
DATABASE_URL=mysql+pymysql://cashxsadev:secret@127.0.0.1:3307/cashxsadev?charset=utf8mb4

# Kredensial awal owner (dibuat oleh `flask seed-owner`)
OWNER_USERNAME=owner
OWNER_PASSWORD=gantipassword

# Mode setup awal (/auth/setup) — hanya dev.
# Kosongkan = setup aktif tanpa token (praktis untuk dev).
# Isi = setup wajib menyertakan token ini. Di production (ProductionConfig)
# SETUP_TOKEN WAJIB diisi, kalau kosong setup otomatis nonaktif (404).
SETUP_TOKEN=
