# Salin ke .env.production lalu isi nilai nyata. JANGAN commit .env.production.
# Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- App ---
FLASK_CONFIG=config.ProductionConfig
FLASK_DEBUG=0
APP_VERSION=1.0.0

# Akses aplikasi: http://<host>:8000 (port host diatur di docker-compose.prod.yml).

# Reverse proxy / TLS diurus step terpisah. Selama diakses HTTP polos
# langsung ke port app: TRUST_PROXY=0 dan SESSION_COOKIE_SECURE=0.
# Saat sudah di belakang proxy + HTTPS (nginx), ubah dua-duanya ke 1.
TRUST_PROXY=0
SESSION_COOKIE_SECURE=0

# --- Keamanan (WAJIB diganti) ---
SECRET_KEY=ganti-dengan-token-hex-32-byte

# --- Database (host = "mysql", port internal 3306) ---
# Password di DATABASE_URL WAJIB sama dengan MYSQL_PASSWORD di
# .env.mysql.production.
DATABASE_URL=mysql+pymysql://cashxsadev:ganti-password-kuat@mysql:3306/cashxsadev?charset=utf8mb4

# --- Owner awal (dibuat manual: ... run --rm app flask seed-owner) ---
OWNER_USERNAME=owner
OWNER_PASSWORD=ganti-password-owner
