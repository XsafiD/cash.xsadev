# Salin ke .env.mysql.production lalu isi nilai nyata. JANGAN commit.
# Password (MYSQL_USER/MYSQL_PASSWORD) WAJIB sama dengan yang ada di
# DATABASE_URL pada .env.production.
MYSQL_ROOT_PASSWORD=ganti-root-password-kuat
MYSQL_DATABASE=cashxsadev
